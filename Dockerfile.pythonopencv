# Dockerfile base para OpenCV - Imagen: darklordcoder/pythonopencv
FROM python:slim-bullseye

# Instalar solo dependencias esenciales para OpenCV
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Instalar OpenCV desde pip
RUN pip install --no-cache-dir \
    opencv-python>=4.8.0 \
    opencv-contrib-python>=4.8.0

# Crear directorio de trabajo
WORKDIR /app

# Exponer puerto por defecto
EXPOSE 5000

# Comando por defecto
CMD ["python"]
